# Backend environment configuration for Moon AI Assistant
# Keep your real API_KEY secret on the backend; never expose it in index.html or frontend JS.
API_KEY=your_nvidia_or_openai_api_key_here

# OpenAI-compatible API base (e.g. NVIDIA NIM: https://integrate.api.nvidia.com/v1)
API_BASE_URL=https://integrate.api.nvidia.com/v1
API_MODEL=meta/llama-3.2-11b-vision-instruct

# Set a long random secret to protect private telemetry queries and the owner summary endpoint.
TELEMETRY_ADMIN_TOKEN=replace_with_a_long_random_secret
PORT=3000

# Optional: if you split frontend and backend across domains
# SITE_ORIGIN=https://your-portfolio-domain.example
# DATA_DIR=/var/data
